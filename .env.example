# Copia este fichero a .env y pon tu clave:  cp .env.example .env
# Como obtener la clave de Gemini: ver la seccion "Obtener la API key de Gemini" del README.

# Clave de la API de Gemini (Google AI Studio). Necesaria solo para adk_orchestrator.py / adk web.
GOOGLE_API_KEY=tu_api_key_de_gemini_aqui

# Usa la API de Gemini (AI Studio) en lugar de Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
